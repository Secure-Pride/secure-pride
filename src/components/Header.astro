---
/**
 * Site header: brand mark + wordmark, then the primary routes.
 * Each route carries its own gem; the current route is marked with
 * aria-current and a gem underline (never color alone — weight and
 * brightness change too).
 */
import BrandMark from './site/BrandMark.astro';
import { PRIMARY, isCurrent } from '../lib/site/nav';
import '../styles/site.css';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <nav class="site-header__inner" aria-label="Main navigation">
    <a class="site-header__home" href="/" aria-label="Secure Pride home">
      <BrandMark variant="small" size={36} idPrefix="hdr" class="site-header__mark" />
      <span class="site-header__wordmark" aria-hidden="true">Secure Pride</span>
    </a>
    <ul class="site-nav" role="list">
      {PRIMARY.map((route) => {
        const current = isCurrent(route, pathname);
        return (
          <li class="site-nav__item" data-gem={route.gem}>
            <a
              class="site-nav__link"
              href={route.href}
              aria-current={current ? 'page' : undefined}
            >
              <span class="site-nav__shard" aria-hidden="true" />
              {route.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
