---
/**
 * Site footer: the medium-tier mark as a sign-off, the founding line kept
 * from the 2026-10-02 site, and the secondary routes.
 */
import BrandMark from './site/BrandMark.astro';
import { PRIMARY, SECONDARY, EXTERNAL } from '../lib/site/nav';
import '../styles/site.css';
---

<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer__inner">
    <div class="site-footer__sign">
      <BrandMark variant="medium" size={128} idPrefix="ftr" class="site-footer__mark" />
      <p class="site-footer__line">
        Security infrastructure for people who cannot fail safely.
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <ul role="list">
        {PRIMARY.map((route) => (
          <li data-gem={route.gem}><a href={route.href}>{route.label}</a></li>
        ))}
      </ul>
      <ul role="list">
        {SECONDARY.map((route) => (
          <li data-gem={route.gem}><a href={route.href}>{route.label}</a></li>
        ))}
        <li><a href="/tools/scanner/">Text scanner</a></li>
      </ul>
      <ul role="list">
        {EXTERNAL.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="site-footer__legal">
      © 2026 Secure Pride. Code licensed under Apache 2.0.
    </p>
  </div>
</footer>
