---
/** 404. Copy unchanged; new shell. */
import PageShell from '../layouts/PageShell.astro';
import { PRIMARY, type Route } from '../lib/site/nav';

const route: Route = {
  href: '/404/',
  label: 'Not found',
  gem: 'amber',
  index: '404',
  blurb: '',
};
---

<PageShell
  route={route}
  documentTitle="404 - Page Not Found | SecurePride"
  description="This page could not be found."
  eyebrow="404"
  heading="Page Not Found"
  lede="We couldn't find the page you're looking for. It might have been moved or deleted."
  noindex
>
  <section class="section section--wide" aria-label="Where to go instead">
    <div class="actions">
      <a class="k-button k-button--opal" href="/">Back to Home</a>
      {PRIMARY.map((r) => <a class="k-link" href={r.href}>{r.label}</a>)}
    </div>
  </section>
</PageShell>
