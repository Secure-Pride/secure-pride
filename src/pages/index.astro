---
/**
 * Home: one statement, one interaction, then a ruled sheet of facts (led
 * by the threat model, DECISION-011) and the doorways. Every fact cell restates something the 2026-10-02 site,
 * the privacy notice, or the tools page already says; nothing is new claim.
 * The statement itself is new and needs the founder's sign-off.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KintsugiVessel from '../components/site/KintsugiVessel.astro';
import RunningHead from '../components/site/RunningHead.astro';
import { HOME, PRIMARY } from '../lib/site/nav';
import { SCENARIOS } from '../lib/threat-model/corpus';
import { MODEL_FACTS } from '../lib/threat-model/model';
import '../styles/site.css';

const facts = [
  {
    label: 'Where text goes',
    value: 'Cloudflare-hosted API',
    note: 'The app does not intentionally store submitted text. Hosting log retention is not yet verified.',
    link: { href: '/privacy/', text: 'Privacy and processing' },
  },
  {
    label: 'Inspect it',
    value: 'Apache 2.0',
    note: 'The code is open. The Docker image serves the interface, not the scanner API.',
    link: { href: 'https://github.com/Secure-Pride/secure-pride', text: 'Source on GitHub' },
  },
  {
    label: 'In development',
    value: 'Rust/WASM scanner',
    note: 'Built, not deployed to the public scanner route.',
    link: { href: 'https://github.com/Secure-Pride/secure-pride/tree/main/scanner-rs', text: 'Inspect the next scanner' },
  },
];
---

<Layout
  title="Secure Pride — Security infrastructure for people who cannot fail safely"
  description="Open-source security tools for LGBTQ+ organizations. Start with a bounded text scanner, understand its limits, and see who is building it."
  canonicalUrl="https://securepride.org/"
  bodyClass="site-body"
>
  <div class="site" data-gem={HOME.gem}>
    <Header />
    <main id="main-content" class="surface-charcoal home">
      <div class="wrap">
        <RunningHead route={HOME} />
      </div>
      <div class="wrap home__grid">
        <p class="page-index" aria-hidden="true">
          <span>{HOME.index}</span><span>The statement</span>
        </p>

        <div>
          <KintsugiVessel headingId="statement">
            Most security is built for people who can afford to fail.
          </KintsugiVessel>

          <div class="ledger ledger--home" role="group" aria-label="What is available and where its limits are">
            <div class="cell cell--feature" data-gem="amber">
              <h2 class="cell__label">At the centre · Threat model v{MODEL_FACTS.version}</h2>
              <span class="cell__value">Who gets exposed, and what the fix might break.</span>
              <p class="cell__note">
                {SCENARIOS.length} invented scenarios of disclosure, coercion, and lost
                access to care. Each names who bears the harm, the control we
                propose, what that control could break, and the test that would
                show it works. A working draft: not yet reviewed by the people it
                is for.
              </p>
              <div class="actions">
                <a class="k-button k-button--opal" href="/threat-model/">Read the threat model</a>
                <a class="k-link" href="/threat-model/scenarios/sp-01/">Start with SP-01: a reminder that discloses care →</a>
              </div>
            </div>
            <div class="cell cell--lede">
              <p class="home__lede">
                Secure Pride builds open-source tools for LGBTQ+ organizations,
                where a privacy failure can become someone else’s personal
                risk. Start with what is available today, understand its
                limits, and decide whether it fits your work.
              </p>
              <div class="actions">
                <a class="k-link" href="/stakes/">Who pays when a control fails →</a>
              </div>
            </div>
            <div class="cell cell--now" data-gem="sapphire">
              <h2 class="cell__label">Available now</h2>
              <span class="cell__value">AI Safety Scanner</span>
              <p class="cell__note">Manual text check. No account or payment needed.</p>
              <div class="actions">
                <a class="k-button k-button--opal" href="/tools/">See the available tool</a>
              </div>
            </div>
            {facts.map((fact) => (
              <div class="cell cell--fact">
                <h2 class="cell__label">{fact.label}</h2>
                <span class="cell__value">{fact.value}</span>
                <p class="cell__note">{fact.note}</p>
                <a class="k-link cell__link" href={fact.link.href}>{fact.link.text} →</a>
              </div>
            ))}
          </div>

          <nav aria-label="Sections">
            <ul class="doorways" role="list">
              {PRIMARY.map((route) => (
                <li data-gem={route.gem}>
                  <a class="doorway" href={route.href}>
                    <span class="doorway__index" aria-hidden="true">
                      <span class="shard"></span>{route.index}
                    </span>
                    <span class="doorway__title">
                      <span class="doorway__label">{route.label}</span>
                      <span class="doorway__slash" aria-hidden="true"> / </span>
                      <span class="doorway__blurb">{route.blurb}</span>
                    </span>
                    <svg class="doorway__arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                      <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  // The old single-page site linked to in-page anchors. Fragments never
  // reach the server, so _redirects cannot forward them; do it here.
  import { LEGACY_ANCHORS } from '../lib/site/nav';
  const target = LEGACY_ANCHORS[window.location.hash];
  if (target) window.location.replace(target);
</script>
