---
/**
 * Home: one statement, one interaction, four doorways.
 * Copy below the statement is carried from the 2026-10-02 site (#67);
 * the statement itself is new and needs the founder's sign-off.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KintsugiVessel from '../components/site/KintsugiVessel.astro';
import { HOME, PRIMARY } from '../lib/site/nav';
import '../styles/site.css';
---

<Layout
  title="Secure Pride — Security infrastructure for people who cannot fail safely"
  description="Open-source security tools for LGBTQ+ organizations. Start with a bounded text scanner, understand its limits, and see who is building it."
  canonicalUrl="https://securepride.org/"
  bodyClass="site-body"
>
  <div class="site" data-gem={HOME.gem}>
    <Header />
    <main id="main-content" class="surface-charcoal home">
      <div class="wrap home__grid">
        <p class="page-index" aria-hidden="true">
          <span>{HOME.index}</span><span>The statement</span>
        </p>

        <div>
          <KintsugiVessel headingId="statement">
            Most security is built for people who can afford to fail.
          </KintsugiVessel>

          <div class="home__intro">
            <div>
              <p class="home__lede">
                Secure Pride builds open-source tools for LGBTQ+ organizations,
                where a privacy failure can become someone else’s personal
                risk. Start with what is available today, understand its
                limits, and decide whether it fits your work.
              </p>
              <p class="home__note">
                No account or payment needed for the text scanner. Hosted
                processing on Cloudflare.
              </p>
            </div>
            <div class="actions">
              <a class="k-button k-button--opal" href="/tools/">See the available tool</a>
              <a class="k-link" href="/stakes/">Who pays when a control fails →</a>
            </div>
          </div>

          <nav aria-label="Sections">
            <ul class="doorways" role="list">
              {PRIMARY.map((route) => (
                <li data-gem={route.gem}>
                  <a class="doorway" href={route.href}>
                    <span class="doorway__index" aria-hidden="true">{route.index}</span>
                    <span class="doorway__label">{route.label}</span>
                    <span class="doorway__blurb">{route.blurb}</span>
                    <span class="doorway__go" aria-hidden="true">Enter →</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  // The old single-page site linked to in-page anchors. Fragments never
  // reach the server, so _redirects cannot forward them; do it here.
  import { LEGACY_ANCHORS } from '../lib/site/nav';
  const target = LEGACY_ANCHORS[window.location.hash];
  if (target) window.location.replace(target);
</script>
