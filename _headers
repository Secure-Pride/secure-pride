# Source template for dist/_headers — Cloudflare Pages only reads the copy in
# the build output. scripts/build-headers.mjs (run by `npm run build`) fills
# the {{…}} placeholders with sha256 hashes of the inline <script>/<style>
# elements Astro emits for React islands. Never add 'unsafe-inline'.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}}; style-src 'self' {{STYLE_HASHES}}; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Astro's build output: content-hashed filenames, safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
